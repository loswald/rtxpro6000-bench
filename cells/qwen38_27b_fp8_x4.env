# =============================================================================
# qwen38_27b_fp8_x4 — Qwen/Qwen3.8-27B-FP8 (official block-scaled FP8
# checkpoint, multimodal Qwen3_5ForConditionalGeneration, 31 GB on disk, Hub sha
# 017b9c7 2026-08-14), FOUR independent TP1 servers on ports 8000-8003.  Twin of
# qwen38_27b_bf16_x4; the kv_diff (fp8 vs auto) target.
#
# Source / flags: see qwen38_27b_bf16_x4.env (recipe FP8 TP4 row uses
# --kv-cache-dtype fp8 --reasoning-parser qwen3).  FP8 GEMM on sm_120 goes
# through cutlass/triton (VLLM_USE_DEEP_GEMM=0 in bench/env.sh: DeepGEMM has no
# sm_120 kernels).
#
# Memory: ~28 GB weights -> ~60 GB/GPU for KV at 0.92 (fp8 KV).  TP1: no dagger.
# Smallest model of the campaign -> first cell to run while the big MoEs download.
# =============================================================================
CELL_NAME=qwen38_27b_fp8_x4
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel)"
MODEL=Qwen/Qwen3.8-27B-FP8
SERVED_MODEL_NAME=qwen38_27b_fp8
TP=1
DP=1
REPLICAS=${REPLICAS:-4}              # gates/run_kv_diff.sh exports REPLICAS=1 GPU_IDS=<first GPU> (KVDIFF_SINGLE_REPLICA=1)
GPU_IDS=${GPU_IDS:-0,1,2,3}          # one independent server per GPU; no cross-GPU traffic
BASE_PORT=8000
USE_PROXY=${USE_PROXY:-1}
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
ENABLE_EP=0
CELL_EXTRA_ARGS=(
  --language-model-only              # text-only bench: skip the vision tower
  --reasoning-parser qwen3
  --tool-call-parser qwen3_coder
  --enable-auto-tool-choice
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="FP8 GEMM path on sm_120 (no DeepGEMM: VLLM_USE_DEEP_GEMM=0 -> cutlass/triton fp8). Also the lightweight COTENANT_MODEL alternative."
