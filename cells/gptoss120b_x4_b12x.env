# =============================================================================
# gptoss120b_x4_b12x — openai/gpt-oss-120b, FOUR TP1 servers, --moe-backend b12x:
# the Blackwell-12.x (sm_120: RTX PRO 6000 / DGX Spark) MXFP4 MoE kernels from
# the `b12x` package (= the `vllm[b12x]` extra installed by bench/setup_engine.sh).
# Third arm of the gpt-oss MoE-backend A/B and the most likely winner on this
# hardware, so it is included even though the CONTEXT only names marlin and
# flashinfer_cutlass.
#
# vLLM main 2026-09-02 (vllm/config/kernel.py MoEBackend literal +
# fused_moe/oracle/mxfp4.py):
#   * `b12x`           = "Use b12x FP4 MoE kernels on SM12x"; for MXFP4 it maps to
#                        B12X_MXFP4_MXFP8 then B12X_MXFP4_BF16 (bf16-activation
#                        variant forced with VLLM_B12X_MOE_FP4_FORCE_A16=1).
#                        "B12xExperts validates the required MXFP4 block alignment
#                        before selecting the backend" -> a rejection is possible
#                        and would be recorded in launch.json.
#   * `flashinfer_b12x` = "FlashInfer CuteDSL fused MoE for SM12x" -- a DIFFERENT
#                        backend, NOT a spelling variant, and NOT in the MXFP4
#                        mapping: for gpt-oss it raises
#                        "moe_backend='flashinfer_b12x' is not supported for MXFP4
#                        MoE".  Do not use it here (it targets other quant formats).
#   `auto` never picks b12x (not in the gpt-oss priority list) -> pin it explicitly.
# Memory/KV: as gptoss120b_x4_marlin (~63 GB weights, ~23 GB KV per GPU).  TP1: no dagger.
# =============================================================================
CELL_NAME=gptoss120b_x4_b12x
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel) + flashinfer-python 0.6.18 + vllm[b12x] (b12x package required by this cell)"
MODEL=openai/gpt-oss-120b            # prefetch with --exclude 'original/*' 'metal/*' (65 GB instead of 196)
SERVED_MODEL_NAME=gptoss120b_b12x
TP=1
DP=1
REPLICAS=${REPLICAS:-4}              # gates/run_kv_diff.sh exports REPLICAS=1 GPU_IDS=<first GPU> (KVDIFF_SINGLE_REPLICA=1)
GPU_IDS=${GPU_IDS:-0,1,2,3}          # one independent server per GPU; no cross-GPU traffic
BASE_PORT=8000
USE_PROXY=${USE_PROXY:-1}
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
ENABLE_EP=0
CELL_EXTRA_ARGS=(
  --moe-backend "${MOE_BACKEND:-b12x}"          # MOE_BACKEND=triton for a fourth arm; flashinfer_b12x is invalid for MXFP4
  --tool-call-parser openai
  --reasoning-parser openai_gptoss
  --enable-auto-tool-choice
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="SM12x-native MXFP4 arm; needs python3 -c 'import b12x' to succeed (bench/setup_engine.sh). Skip if the b12x package is unavailable."
