# =============================================================================
# qwen35_122b_fp8_tp2x2 — Qwen/Qwen3.5-122B-A10B-FP8 (122B MoE / 10B active,
# hybrid Gated-DeltaNet + attention, multimodal checkpoint
# Qwen3_5MoeForConditionalGeneration, 127 GB on disk, Hub sha a099dee) as
# DP2 x TP2 in one vLLM server = two TP2 replicas.
#
# Source: https://recipes.vllm.ai/Qwen/Qwen3.5-122B-A10B  (FP8 TP2 row:
# --tensor-parallel-size 2 --reasoning-parser qwen3; throughput row:
# -dp 4 --enable-expert-parallel --language-model-only --enable-prefix-caching;
# vLLM >= 0.17).  Flags verified in vLLM main 2026-09-02: --language-model-only
# (multimodal group), --reasoning-parser qwen3 (registered), --kv-cache-dtype fp8.
#
# GPU layout (decision 3): GPU_IDS=0,2,1,3 -> DP rank0 = physical GPUs 0,2,
# rank1 = 1,3 (vLLM hands DP rank i the i-th TP-sized slice of
# CUDA_VISIBLE_DEVICES).  Both TP2 pairs are CROSS-switch: with PCIe ACS on,
# same-switch P2P is bounced through the root complex and measured NCCL
# all_reduce is ~21 GB/s for 0-1 vs ~38 GB/s for 0-2.  TP2 over PCIe with ACS
# on is still a pessimistic lower bound -> dagger.
#
# Memory: ~61 GB weights/GPU -> ~27 GB/GPU for KV at 0.92.  fp8 KV per CONTEXT
# (FP8 KV validated for the Qwen3.5/3.8 hybrid family on sm_120 by the
# Qwen3.8-27B recipe's RTX 5090 rows; the recurrent GDN state stays fp32).
# =============================================================================
CELL_NAME=qwen35_122b_fp8_tp2x2
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel); Qwen3.5 supported since v0.17"
MODEL=Qwen/Qwen3.5-122B-A10B-FP8
SERVED_MODEL_NAME=qwen35_122b
TP=2
DP=2
REPLICAS=1
GPU_IDS=0,2,1,3                      # DP rank0 -> phys 0,2 ; rank1 -> phys 1,3 (cross-switch pairs, see header)
BASE_PORT=8000
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
# ENABLE_EP=1 = the recipe's throughput row (experts sharded over all 4 GPUs, EP size = DP x TP):
# on this ACS-on PCIe box that is an all-to-all through the root complex every MoE layer.
# Default OFF = two independent TP2 replicas.  A/B:  ENABLE_EP=1 RUN_TAG=ep bench/launch.sh qwen35_122b_fp8_tp2x2
ENABLE_EP=${ENABLE_EP:-0}
CELL_EXTRA_ARGS=(
  --language-model-only              # text-only bench: skip the vision tower
  --reasoning-parser qwen3
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="DP2xTP2 on cross-switch pairs (0,2)+(1,3). A/B ENABLE_EP=1 (RUN_TAG=ep) to see whether EP all-to-all over PCIe beats independent TP2 replicas. TP2: pessimistic (dagger)."
