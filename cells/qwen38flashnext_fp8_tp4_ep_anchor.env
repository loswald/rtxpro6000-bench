# Official native FP8 anchor on pinned vLLM g798544433. Download revision below
# with vast/download_priority_qwen.sh before launch. No PLE loader/offload patch.
CELL_NAME=qwen38flashnext_fp8_tp4_ep_anchor
ENGINE=vllm
IMAGE_HINT="vllm 0.28.1rc1.dev446+g798544433; torch 2.13.0+cu130; flashinfer 0.6.18"
MODEL=Qwen/Qwen3.8-Flash-Next-FP8
MODEL_REVISION=236dfdf285828023ca3bcd3f37366c58a3469b13
SERVED_MODEL_NAME=qwen38flashnext
TP=4
DP=1
REPLICAS=1
GPU_IDS=${GPU_IDS:-0,1,2,3}
BASE_PORT=8000
KV_CACHE_DTYPE=bfloat16
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.90}
ENABLE_EP=1
COMPILATION_CONFIG=${QWEN_COMPILATION_CONFIG:-}
if [ -z "$COMPILATION_CONFIG" ]; then COMPILATION_CONFIG='{}'; fi
export VLLM_USE_DEEP_GEMM=0
export VLLM_QWEN4EXP_PLE_FP8=0
export VLLM_QWEN4EXP_PLE_OPAQUE_LOOKUP=${VLLM_QWEN4EXP_PLE_OPAQUE_LOOKUP:-0}
unset VLLM_PLE_CPU_OFFLOAD
HOST_RAM_NEEDED_GB=0
CELL_EXTRA_ARGS=(
  --dtype bfloat16
  --mamba-cache-dtype bfloat16
  --mamba-ssm-cache-dtype float32
  --language-model-only
  --reasoning-parser qwen3
  --tool-call-parser qwen3_coder
  --enable-auto-tool-choice
)
if [ "${ENFORCE_EAGER:-0}" = 1 ]; then CELL_EXTRA_ARGS+=( --enforce-eager ); fi
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="Native FP8 weights, TP4+EP4, BF16 KV and conv/PLE state, FP32 GDN recurrent state, speculation off. Compiler workaround is separately opt-in."
