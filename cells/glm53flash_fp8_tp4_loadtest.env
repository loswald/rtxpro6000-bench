# =============================================================================
# glm53flash_fp8_tp4_loadtest — zai-org/GLM-5.3-Flash (320B total / 18B active,
# official FP8 weights ~306 GiB = 328 GB on disk, sparse MLA; Hub sha 03eb536
# 2026-08-31, architecture Glm5NextForConditionalGeneration) -- ATTEMPT TO LOAD ONLY.
#
# Source: https://recipes.vllm.ai/zai-org/GLM-5.3-Flash (GB200 TP4 row:
# --tensor-parallel-size 4 --kv-cache-dtype fp8 --tool-call-parser glm47
# --reasoning-parser glm45 --enable-auto-tool-choice; "Hopper does not support
# FP8 KV cache" -> bf16 there; needs FlashInfer >= 0.6.17/0.6.18 for the
# sparse-MLA indexer; image vllm/vllm-openai:glm53-flash-x86_64-cu130).
#
# IMPORTANT (checked 2026-09-02): `Glm5NextForConditionalGeneration` is NOT in
# vLLM main's model registry (vllm/model_executor/models/registry.py lists
# Glm4Moe*, GlmMoeDsa*, Glm4v*, ... but no Glm5Next*).  On the in-place-upgraded
# main build the expected failure is therefore "Model architectures [...] are not
# supported" at start-up -- NOT an sm_120 kernel error -- and only the recipe's
# model-launch image knows the model.  Spending a 328 GB download (390 GB disk:
# every other model must be deleted first) to record a registry miss is poor
# value: run this cell LAST, alone, and only if a build with Glm5Next support is
# available; otherwise record the registry check itself in the memo.
# If it does load: 306 GiB / 4 = ~77 GiB weights per 96 GB GPU leaves ~14 GiB for
# everything else -> KV_CACHE_DTYPE=bfloat16 as the second attempt is unlikely
# to fit.  launch.sh writes results/<cell>/loadtest.json + loadtest_log_tail.txt
# and tears down.  Parsers glm47 / glm45 are registered in main.
# =============================================================================
CELL_NAME=glm53flash_fp8_tp4_loadtest
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="requires a build with Glm5NextForConditionalGeneration: recipe image vllm/vllm-openai:glm53-flash-x86_64-cu130 (2026-08-26); vLLM main 2026-09-02 lacks it"
MODEL=zai-org/GLM-5.3-Flash
SERVED_MODEL_NAME=glm53flash
TP=4
DP=1
REPLICAS=1
GPU_IDS=0,1,2,3
BASE_PORT=8000
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8}        # recipe (Blackwell supports FP8 KV); KV_CACHE_DTYPE=bfloat16 as 2nd attempt
MAX_MODEL_LEN=${MAX_MODEL_LEN:-16384}        # small on purpose: this cell only asks "does it load?"
MAX_NUM_SEQS=${MAX_NUM_SEQS:-64}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-4096}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.95}
ENABLE_EP=${ENABLE_EP:-0}
CELL_EXTRA_ARGS=(
  --language-model-only              # multimodal checkpoint; text-only load test
  --reasoning-parser glm45
  --tool-call-parser glm47
  --enable-auto-tool-choice
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=1
HEALTH_TIMEOUT=${HEALTH_TIMEOUT:-5400}       # 90 min: a 306 GiB load that has not answered /health by then has failed
NOTES="Record-the-error cell. Do not sweep. 328 GB download only fits alone on the 390 GB disk; architecture missing from vLLM main 2026-09-02 -> run last or skip."
