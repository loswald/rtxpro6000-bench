# =============================================================================
# gptoss120b_x4_ficutlass — openai/gpt-oss-120b, FOUR TP1 servers,
# --moe-backend flashinfer_cutlass (FlashInfer CUTLASS MXFP4 MoE).  A/B against
# the marlin baseline.
#
# vLLM main 2026-09-02: `flashinfer_cutlass` is a valid MXFP4 spelling -- the
# oracle maps it to FLASHINFER_CUTLASS_MXFP4_BF16 / _MXFP8 -- but whether
# is_supported_config() admits it on compute capability 12.0 is UNVERIFIED
# (2026-09-02); FlashInfer's CUTLASS MXFP4 MoE kernels are SM100-class, so the
# EXPECTED outcome is a rejection at start-up ("No MXFP4 MoE backend supports the
# deployment configuration" or a capability error).  launch.sh then records the
# excerpt in launch.json.error_excerpt and exits 1 -- that is a valid result for
# the Scan decision (the Server Edition card has no SM100 kernels).  FlashInfer
# JIT targets FLASHINFER_CUDA_ARCH_LIST=12.0f (bench/env.sh).
# =============================================================================
CELL_NAME=gptoss120b_x4_ficutlass
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel) + flashinfer-python 0.6.18 + vllm[b12x]"
MODEL=openai/gpt-oss-120b            # prefetch with --exclude 'original/*' 'metal/*' (65 GB instead of 196)
SERVED_MODEL_NAME=gptoss120b_fic
TP=1
DP=1
REPLICAS=${REPLICAS:-4}              # gates/run_kv_diff.sh exports REPLICAS=1 GPU_IDS=<first GPU> (KVDIFF_SINGLE_REPLICA=1)
GPU_IDS=${GPU_IDS:-0,1,2,3}          # one independent server per GPU; no cross-GPU traffic
BASE_PORT=8000
USE_PROXY=${USE_PROXY:-1}
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
ENABLE_EP=0
CELL_EXTRA_ARGS=(
  --moe-backend "${MOE_BACKEND:-flashinfer_cutlass}"
  --tool-call-parser openai
  --reasoning-parser openai_gptoss
  --enable-auto-tool-choice
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="If unsupported on sm_120 (expected), launch.json.error_excerpt is the deliverable. Do not spend more than one launch attempt on it."
