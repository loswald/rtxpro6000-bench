# =============================================================================
# ds4flash_tp4 — deepseek-ai/DeepSeek-V4-Flash-0731 (284B total / 13B active MoE,
# MXFP4 experts + FP8 attention, 167 GB on disk, Hub sha 7872f01, 2026-08-01)
# as ONE TP4 server across all four GPUs.
#
# Source: https://recipes.vllm.ai/deepseek-ai/DeepSeek-V4-Flash, RTX PRO 6000
# (sm_120) row, verbatim flags:  --kv-cache-dtype fp8 --block-size 256
# --enable-expert-parallel --moe-backend auto
# --attention_config.use_fp4_indexer_cache False --tokenizer-mode deepseek_v4
# --tool-call-parser deepseek_v4 --enable-auto-tool-choice --reasoning-parser
# deepseek_v4 (+ --reasoning-config and a DSpark --speculative-config that we
# leave OFF: throughput campaign).  Recipe caveats: "sm_120 cannot use the SM100
# FP4 indexer cache or deep_gemm_mega_moe"; "Do not use method: mtp on 0731".
#
# Verified against vLLM main 2026-09-02:
#   * sparse-MLA backends on capability 12.x: TRITON_MLA, FLASHINFER_MLA_SPARSE_SM120;
#     the SM120 backend accepts kv dtypes auto|fp8|fp8_e4m3|fp8_ds_mla, block sizes
#     64|256, bf16 model dtype, index_topk 2048, and its impl requires the packed
#     fp8_ds_mla layout; vllm/models/deepseek_v4/sparse_mla.py lists "fp8" as an
#     alias for fp8_ds_mla  -> KV_CACHE_DTYPE=fp8_ds_mla (CONTEXT) == recipe's fp8.
#   * --tokenizer-mode deepseek_v4 (TokenizerMode literal + tokenizers registry),
#     --tool-call-parser deepseek_v4 and --reasoning-parser deepseek_v4 (registered),
#     --moe-backend is a top-level flag (KernelConfig.moe_backend), --block-size >0 ok.
#   * --attention_config.use_fp4_indexer_cache False: dotted form is accepted by
#     FlexibleArgumentParser (underscore->hyphen, nested key repacked as JSON); the
#     field is a DEPRECATED alias of indexer_kv_dtype (auto|bf16|fp8|mxfp4|nvfp4),
#     False is a no-op and removal is announced for v0.29 -> kept for recipe parity,
#     DS4_LEGACY_INDEXER_FLAG=0 drops it if a newer build rejects it.
#   * MXFP4 MoE oracle: 'auto' priority on this arch = FLASHINFER_TRTLLM (SM100 only)
#     -> DEEPGEMM (VLLM_USE_DEEP_GEMM=0, no sm_120 kernels) -> MARLIN, so expect
#     marlin.  Explicit A/B: MOE_BACKEND=b12x (vllm[b12x] SM12x MXFP4 kernels;
#     "B12xExperts validates the required MXFP4 block alignment") or triton.
#     Which one 'auto' really picks on sm_120 is UNVERIFIED (2026-09-02): read the
#     server log line "Using ... MXFP4 MoE backend".
#
# GPU layout: TP4 on 0,1,2,3 (PCIe Gen5, no NVLink, ACS on: 4-GPU NCCL ring ~19 GB/s)
# -> numbers are a PESSIMISTIC lower bound for a node with working switch-local P2P;
# summarise.py marks TP>1 rows with a dagger.  Compare against ds4flash_tp2x2.
#
# Memory: ~42 GB weights/GPU -> ~45 GB/GPU for KV at 0.92.  DeepSeek-V4 stores
# compressed MLA KV (fp8_ds_mla, plus the V4 KV compressor) so the agent shape at
# C=256 should fit; check launch.json's "GPU KV cache size" line before sweeping.
#
# If the server dies inside deep_gemm_fp8_o_proj / fp8_einsum (DeepGEMM has no sm_120
# kernels): patches/apply_dsv4_o_proj.sh --apply installs the hand patch
# patches/vllm_dsv4_nvidia_ops_o_proj.py (SM90 scale layout on cc 12.x; optional bf16
# fallback with VLLM_DSV4_OPROJ_SM120_FALLBACK=1).  UNVERIFIED (2026-09-02); record the
# outcome in launch.json / NOTES.
# =============================================================================
CELL_NAME=ds4flash_tp4
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel) + flashinfer-python 0.6.18 + vllm[b12x], in place over vllm/vllm-openai:cu130-nightly (stale 0.19.2)"
MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=ds4flash
TP=4
DP=1
REPLICAS=1
GPU_IDS=0,1,2,3                      # TP4 = all four GPUs; pessimistic (ACS-on PCIe ring)
BASE_PORT=8000
# fp8_ds_mla = packed DeepSeek sparse-MLA fp8 layout (CONTEXT); the recipe's sm_120 row
# spells it `fp8`, which vLLM main treats as an alias.  If a build rejects fp8_ds_mla:
#   KV_CACHE_DTYPE=fp8 bench/launch.sh ds4flash_tp4
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8_ds_mla}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
# Recipe default for RTX PRO 6000 is TP+EP.  On this box EP means an all-to-all over
# PCIe through the root complex (ACS on) every MoE layer; plain TP4 all-reduces instead.
# Keep the recipe default, A/B with:  ENABLE_EP=0 RUN_TAG=noep bench/launch.sh ds4flash_tp4
ENABLE_EP=${ENABLE_EP:-1}
DS4_INDEXER_ARGS=( --attention_config.use_fp4_indexer_cache False )   # recipe flag; deprecated no-op alias (see header)
if [ "${DS4_LEGACY_INDEXER_FLAG:-1}" != 1 ]; then DS4_INDEXER_ARGS=( ); fi
CELL_EXTRA_ARGS=(
  --tokenizer-mode deepseek_v4
  --block-size 256
  --moe-backend "${MOE_BACKEND:-auto}"
  ${DS4_INDEXER_ARGS[@]+"${DS4_INDEXER_ARGS[@]}"}
  --reasoning-parser deepseek_v4
  --tool-call-parser deepseek_v4
  --enable-auto-tool-choice
)
# Recipe's sm_120 row also passes (chat/thinking-budget only, irrelevant for /v1/completions):
#   --reasoning-config '{"reasoning_parser":"deepseek_v4","reasoning_start_str":"","reasoning_end_str":""}'
# Optional DSpark A/B (recipe: nightly vLLM + FlashInfer with the SM120 sparse-MLA decode kernel
# for topk=192); OFF by default -- spec decoding is off everywhere in this campaign:
# SPEC_CONFIG='{"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"probabilistic"}'
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
# The bench client loads the tokenizer from MODEL_PATH (the local directory) with --tokenizer-mode auto
# (HF tokenizer files are in the repo).  Checked against vLLM main 2026-09-02: `vllm bench serve
# --tokenizer-mode` has NO argparse `choices` (type=str; help lists auto/hf/slow/mistral/deepseek_v32
# "other custom values via plugins") and is resolved by vllm/tokenizers/registry.py, where deepseek_v4
# IS registered (same registry the server literal uses) -> DS4_BENCH_TOKENIZER_MODE=deepseek_v4 is a
# valid client value; whether the client path then loads the DeepSeek-V4 tokenizer files cleanly is
# UNVERIFIED (2026-09-02).  Alternative: DS4_BENCH_TOKENIZER=<other local tokenizer dir> overrides
# --tokenizer (argparse keeps the last occurrence).
DS4_BENCH_ARGS=( )
if [ -n "${DS4_BENCH_TOKENIZER_MODE:-}" ]; then DS4_BENCH_ARGS+=( --tokenizer-mode "$DS4_BENCH_TOKENIZER_MODE" ); fi
if [ -n "${DS4_BENCH_TOKENIZER:-}" ]; then DS4_BENCH_ARGS+=( --tokenizer "$DS4_BENCH_TOKENIZER" ); fi
BENCH_EXTRA_ARGS=( ${DS4_BENCH_ARGS[@]+"${DS4_BENCH_ARGS[@]}"} )
LOADTEST_ONLY=0
NOTES="Recipe-validated sm_120 flags; EP on (A/B ENABLE_EP=0). TP4 over ACS-on PCIe: pessimistic (dagger). Compare against ds4flash_tp2x2."
