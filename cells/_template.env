# =============================================================================
# cells/_template.env — every variable a cell may set.  Copy to <cell>.env.
# Files are sourced by bash (bench/env.sh:load_cell) inside scripts that run
# with `set -euo pipefail`, so arrays and ${VAR:-x} overrides are fine; expand
# possibly-empty arrays as  ${ARR[@]+"${ARR[@]}"}.  Use ${VAR:-default} for
# anything you want overridable from the command line, e.g.
#   KV_CACHE_DTYPE=fp8 RUN_TAG=kvfp8 bench/launch.sh <cell>
#
# Variables consumed by bench/env.sh:load_cell (exported to launch/sweep/stop):
#   CELL_NAME ENGINE MODEL SERVED_MODEL_NAME TP DP REPLICAS GPU_IDS BASE_PORT
#   KV_CACHE_DTYPE MAX_MODEL_LEN MAX_NUM_SEQS MAX_NUM_BATCHED_TOKENS GPU_MEM_UTIL
#   ENABLE_EP BENCH_BACKEND BENCH_ENDPOINT LOADTEST_ONLY USE_PROXY HEALTH_TIMEOUT
#   HOST_RAM_NEEDED_GB
# Consumed directly by bench/launch.sh:  IMAGE_HINT CELL_EXTRA_ARGS SGLANG_EXTRA_ARGS
#   SPEC_CONFIG ENABLE_SLEEP_MODE (+ any `export VLLM_*` / `NCCL_*` the cell sets)
# Consumed directly by bench/sweep.sh:   BENCH_EXTRA_ARGS
# Anything else (NOTES, cell-local helper vars) is documentation only.
#
# GPU layout rules for THIS box (4x RTX PRO 6000 Blackwell Server, PCIe Gen5,
# no NVLink; nvidia-smi topo: 0-1 PIX, 2-3 PIX, cross pairs NODE; PCIe ACS on ->
# measured NCCL all_reduce busbw: pair 0-1 ~21 GB/s, pair 0-2 ~38 GB/s, 4-ring ~19):
#   * TP1 replica cells (REPLICAS=4):      GPU_IDS=0,1,2,3  (one server per GPU)
#   * DP2 x TP2 in one server:              GPU_IDS=0,2,1,3  (vLLM gives DP rank i the
#     i-th TP-sized slice of CUDA_VISIBLE_DEVICES -> rank0 = phys 0,2; rank1 = 1,3:
#     both replicas pair CROSS-switch, ~1.8x the all-reduce bandwidth of 0,1 / 2,3)
#   * TP4:                                  GPU_IDS=0,1,2,3, results marked pessimistic
#   Never set NCCL_P2P_DISABLE here (P2P works and beats host staging on this box).
# =============================================================================
CELL_NAME=_template                        # results/<CELL_NAME>[__$RUN_TAG]/, tmux bench_<CELL_NAME>
ENGINE=${ENGINE:-vllm}                     # vllm | sglang  (sglang = optional A/B on a 2nd instance)
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel) upgraded in place over vllm/vllm-openai:cu130-nightly"   # informational only
MODEL=org/Model-Name                       # public HF id (no token). Weights are expected on disk as
                                           # ${MODELS_DIR:-/workspace/models}/$(basename "$MODEL") (hf download --local-dir);
                                           # load_cell derives MODEL_PATH from this and falls back to the HF id.
                                           # Free the disk with  bench/prefetch.sh --delete <cell>  (or rm -rf that dir).
SERVED_MODEL_NAME=short_alias              # --served-model-name; bench uses this as --model
TP=1                                       # --tensor-parallel-size
DP=1                                       # --data-parallel-size (internal LB, one port)
REPLICAS=1                                 # >1 = independent servers on BASE_PORT..+N-1, one GPU each (TP=DP=1)
GPU_IDS=0,1,2,3                            # CUDA_VISIBLE_DEVICES (single server) or one GPU per replica; see rules above
BASE_PORT=8000
USE_PROXY=${USE_PROXY:-1}                  # REPLICAS>1: also start rr_proxy.py on $PROXY_PORT (8080)
# --kv-cache-dtype (vLLM main CacheDType, verified 2026-09-02): auto|float16|bfloat16|fp8|fp8_e4m3|
#   fp8_e5m2|fp8_inc|fp8_ds_mla|nvfp4_ds_mla|...  Campaign choice: fp8_ds_mla for DeepSeek sparse MLA
#   (fp8 is an alias for it there), bfloat16 for Qwen3.8-Flash-Next, fp8 for gpt-oss / Qwen3.8-27B / Qwen3.5.
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-auto}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}      # >= 32768+2048 for the agent shape
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}   # sweep 8192 / 16384 via RUN_TAG=mnbt16k
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
ENABLE_EP=${ENABLE_EP:-0}                  # 1 -> --enable-expert-parallel (MoE; A/B on PCIe with ACS on)
# SPEC_CONFIG='{"method":"mtp","num_speculative_tokens":3}'   # speculative decoding; OFF everywhere (throughput campaign)
# ENABLE_SLEEP_MODE=1                      # --enable-sleep-mode (train co-tenancy cell)
CELL_EXTRA_ARGS=( )                        # extra `vllm serve` args, JSON values as single elements.
                                           # --moe-backend "${MOE_BACKEND:-...}" lets the CLI pick the MoE kernel:
                                           # MoEBackend literal (vllm/config/kernel.py): auto triton marlin flashinfer_cutlass
                                           # flashinfer_trtllm flashinfer_b12x b12x deep_gemm ... (per-quant validity differs!)
SGLANG_EXTRA_ARGS=( )                      # extra sglang.launch_server args when ENGINE=sglang
# export VLLM_SOMETHING=1                  # cell-specific env for the server processes (launch.sh snapshots VLLM_*/NCCL_*)
# export VLLM_PLE_CPU_OFFLOAD=1            # e.g. Qwen3.8-Flash-Next N-gram table -> host RAM (recipe env; UNVERIFIED in vLLM main)
BENCH_BACKEND=openai                       # openai (/v1/completions) | openai-chat (/v1/chat/completions)
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )                       # extra `vllm bench serve` args (e.g. --tokenizer <other local dir>; --tokenizer-mode X is
                                           # registry-resolved with no argparse choices -- see ds4flash_tp4.env)
LOADTEST_ONLY=0                            # 1 -> launch.sh only records whether the model loads
HEALTH_TIMEOUT=${HEALTH_TIMEOUT:-7200}     # s until launch.sh gives up on /health (load_cell applies the 7200 default)
# HOST_RAM_NEEDED_GB=204                   # optional hint for launch.sh's host-RAM warning (warn, never die), e.g. a
                                           # CPU-offloaded table replicated per TP rank; launch.sh takes max(hint, its own estimate)
NOTES="free text shown nowhere; keep the why here"
