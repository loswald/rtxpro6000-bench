# =============================================================================
# qwen38_27b_bf16_x4 — Qwen/Qwen3.8-27B (27.8B dense hybrid: linear attention on
# 48 of 64 layers, multimodal checkpoint Qwen3_5ForConditionalGeneration, BF16,
# 56 GB on disk, Hub sha 1d4bf0f 2026-08-14) as FOUR independent TP1 servers,
# one per GPU, ports 8000-8003 (+ rr_proxy on 8080).
#
# Source: https://recipes.vllm.ai/Qwen/Qwen3.8-27B (vLLM >= 0.17; RTX 5090 rows:
# --kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice
# --tool-call-parser qwen3_coder  -> FP8 KV validated on sm_120 for this arch).
# Flags verified in vLLM main 2026-09-02: --language-model-only, --reasoning-parser
# qwen3, --tool-call-parser qwen3_coder (registered alongside qwen3_xml).
#
# Memory: ~55 GB BF16 weights -> ~33 GB/GPU for KV at 0.92.  Compare with the
# FP8 twin (qwen38_27b_fp8_x4) for the weight-precision effect on sm_120.
# This cell is the GSM8K reference (REF_JSON) for the FP8 twin.  TP1: no dagger.
# =============================================================================
CELL_NAME=qwen38_27b_bf16_x4
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel); Qwen3.8 supported since v0.17"
MODEL=Qwen/Qwen3.8-27B
SERVED_MODEL_NAME=qwen38_27b
TP=1
DP=1
REPLICAS=${REPLICAS:-4}              # gates/run_kv_diff.sh exports REPLICAS=1 GPU_IDS=<first GPU> (KVDIFF_SINGLE_REPLICA=1)
GPU_IDS=${GPU_IDS:-0,1,2,3}          # one independent server per GPU; no cross-GPU traffic
BASE_PORT=8000
USE_PROXY=${USE_PROXY:-1}
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
ENABLE_EP=0
CELL_EXTRA_ARGS=(
  --language-model-only              # text-only bench: skip the vision tower
  --reasoning-parser qwen3
  --tool-call-parser qwen3_coder
  --enable-auto-tool-choice
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="sweep.sh fans concurrency out per port (sum in summarise.py); --via-proxy for exact-C via 8080. Delete /workspace/models/Qwen3.8-27B after the sweep + gsm8k reference (56 GB)."
