# =============================================================================
# ds4flash_tp2x2 — DeepSeek-V4-Flash-0731 as DP2 x TP2 in ONE vLLM server
# (--data-parallel-size 2 --tensor-parallel-size 2, internal load balancer,
# single port).  Two independent TP2 replicas -> less cross-GPU traffic per
# token than TP4 on a PCIe-only box, at the cost of holding the weights twice.
#
# GPU layout (decision 3): GPU_IDS=0,2,1,3.  vLLM's DP launcher gives DP rank i
# the i-th contiguous TP-sized slice of CUDA_VISIBLE_DEVICES
# (vllm/v1/engine/utils.py: start = local_dp_rank * world_size;
#  user_assigned_gpu_ids[start:stop]) -> rank0 = physical GPUs 0,2 and
# rank1 = physical GPUs 1,3.  Both pairs are CROSS-switch (topo: 0-1 PIX, 2-3
# PIX, cross pairs NODE).  With PCIe ACS enabled on this host, switch-local P2P
# is redirected through the root complex and measured NCCL all_reduce busbw is
# ~21 GB/s for 0-1 but ~38 GB/s for 0-2, so cross-switch pairing is ~1.8x
# faster for every TP2 all-reduce.  GPU_IDS=0,1,2,3 would pair 0-1 / 2-3.
# TP2 over PCIe (ACS on) is still a pessimistic lower bound -> dagger.
#
# Flags: identical to ds4flash_tp4 (recipe sm_120 row; see that file for the
# per-flag verification against vLLM main 2026-09-02).  EP default OFF here:
# with DP, --enable-expert-parallel shards experts across ALL 4 GPUs (EP size =
# DP x TP = 4) and adds an all-to-all through the root complex every MoE layer,
# which defeats the point of independent replicas.  A/B: ENABLE_EP=1 RUN_TAG=ep.
#
# Memory: ~167 GB / TP2 = ~84 GB weights per GPU.  On 96 GB that leaves only
# ~7 GB per GPU for KV + activations at 0.95 util.  KV per token depends on the
# V4 compressor ratio -- read launch.json's "GPU KV cache size" line; expect the
# agent shape (34.8K tokens/seq) to saturate the cache at low C, and OOM at
# cudagraph capture is possible.  Fallbacks: MAX_NUM_SEQS=128, or add
# --max-cudagraph-capture-size 128 to CELL_EXTRA_ARGS, or reduce MAX_MODEL_LEN.
# If it will not load, ds4flash_tp4 is the reference configuration.
# =============================================================================
CELL_NAME=ds4flash_tp2x2
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel) + flashinfer-python 0.6.18 + vllm[b12x] (see ds4flash_tp4)"
MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=ds4flash
TP=2
DP=2
REPLICAS=1
GPU_IDS=0,2,1,3                      # DP rank0 -> phys 0,2 ; rank1 -> phys 1,3 (cross-switch pairs, see header)
BASE_PORT=8000
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8_ds_mla}     # see ds4flash_tp4.env (recipe spelling `fp8` is an alias)
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.95}
# EP with DP shards experts across ALL 4 GPUs (all-to-all every MoE layer over PCIe, ACS on).
# Default OFF = two fully independent TP2 replicas.  ENABLE_EP=1 RUN_TAG=ep to A/B
# (the recipe's H200/B200 DP4 rows use DP + EP, but those have NVLink).
ENABLE_EP=${ENABLE_EP:-0}
DS4_INDEXER_ARGS=( --attention_config.use_fp4_indexer_cache False )   # recipe flag; deprecated no-op alias (see ds4flash_tp4)
if [ "${DS4_LEGACY_INDEXER_FLAG:-1}" != 1 ]; then DS4_INDEXER_ARGS=( ); fi
CELL_EXTRA_ARGS=(
  --tokenizer-mode deepseek_v4
  --block-size 256
  --moe-backend "${MOE_BACKEND:-auto}"         # expect marlin on sm_120; A/B MOE_BACKEND=b12x|triton
  ${DS4_INDEXER_ARGS[@]+"${DS4_INDEXER_ARGS[@]}"}
  --reasoning-parser deepseek_v4
  --tool-call-parser deepseek_v4
  --enable-auto-tool-choice
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
# Bench tokenizer: local MODEL_PATH with mode auto; DS4_BENCH_TOKENIZER_MODE=deepseek_v4 is a valid
# client value (registry-resolved, no argparse choices; see ds4flash_tp4.env), DS4_BENCH_TOKENIZER=<dir>
# overrides --tokenizer.
DS4_BENCH_ARGS=( )
if [ -n "${DS4_BENCH_TOKENIZER_MODE:-}" ]; then DS4_BENCH_ARGS+=( --tokenizer-mode "$DS4_BENCH_TOKENIZER_MODE" ); fi
if [ -n "${DS4_BENCH_TOKENIZER:-}" ]; then DS4_BENCH_ARGS+=( --tokenizer "$DS4_BENCH_TOKENIZER" ); fi
BENCH_EXTRA_ARGS=( ${DS4_BENCH_ARGS[@]+"${DS4_BENCH_ARGS[@]}"} )
LOADTEST_ONLY=0
NOTES="Memory-tight DP2xTP2 on cross-switch pairs (0,2)+(1,3); if OOM record it and rely on ds4flash_tp4. TP2 over ACS-on PCIe: pessimistic (dagger)."
