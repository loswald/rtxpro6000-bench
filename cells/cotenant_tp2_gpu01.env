# =============================================================================
# cotenant_tp2_gpu01 — the SERVING half of the training co-tenancy cell:
# one TP2 server (port 8000) while train/lora_cotenant.sh runs an Unsloth LoRA
# on GPU 3 (TRAIN_GPU=3 default there).  Also the server used by
# train/sleep_wake.sh (ENABLE_SLEEP_MODE=1; bench/env.sh already exports
# VLLM_SERVER_DEV_MODE=1).
#
# GPU layout (decision 3, cross-switch TP2 pairing): default GPU_IDS=0,2 -- the
# two GPUs sit on DIFFERENT PCIe switches, which on this ACS-on host measured
# ~38 GB/s NCCL all_reduce vs ~21 GB/s for the same-switch pair 0,1.  GPU 3 is
# the trainer's, GPU 1 stays idle.  The cell keeps its historical name
# (README / train scripts reference it); COTENANT_GPU_IDS=0,1 restores the
# same-switch pairing for an A/B.  lora_cotenant.sh refuses to start if
# TRAIN_GPU is inside GPU_IDS, and samples dmon on "$GPU_IDS,$TRAIN_GPU".
# TP2 over PCIe with ACS on -> mark the serving numbers pessimistic (dagger).
#
# Default model: Qwen3.5-122B-A10B-FP8 = one replica of qwen35_122b_fp8_tp2x2
# (~61 GB weights/GPU, ~27 GB/GPU KV at 0.92; 127 GB on disk). Override with
# COTENANT_MODEL=Qwen/Qwen3.8-27B-FP8 COTENANT_ALIAS=qwen38_27b_fp8 (31 GB) when
# the 122B has already been deleted for disk space.
# =============================================================================
CELL_NAME=cotenant_tp2_gpu01
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312, cu130) in place over vllm/vllm-openai:cu130-nightly"
MODEL=${COTENANT_MODEL:-Qwen/Qwen3.5-122B-A10B-FP8}
SERVED_MODEL_NAME=${COTENANT_ALIAS:-cotenant}
TP=2
DP=1
REPLICAS=1
GPU_IDS=${COTENANT_GPU_IDS:-0,2}           # cross-switch pair; GPU 3 = trainer, GPU 1 idle (see header)
BASE_PORT=8000
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
ENABLE_EP=0
ENABLE_SLEEP_MODE=${ENABLE_SLEEP_MODE:-1}  # --enable-sleep-mode (CuMemAllocator) for train/sleep_wake.sh
CELL_EXTRA_ARGS=(
  --language-model-only              # Qwen3.5 / Qwen3.8 checkpoints are multimodal; text-only bench
  --reasoning-parser qwen3           # registered name in vllm/reasoning (verified 2026-09-02)
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="Serving half of the co-tenancy cell on the cross-switch pair 0,2. Sleep mode ON: weights become CPU-offloadable, so host RAM >= weights (~122 GB); the box has 1.5 TB."
