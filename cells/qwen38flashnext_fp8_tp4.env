# =============================================================================
# qwen38flashnext_fp8_tp4 — fallback/comparison for qwen38flashnext_fp8_tp2x2:
# ONE TP4 server (the historical recipe's 4-GPU configuration).
# The pinned qwen38flashnext_fp8_tp4_ep_anchor is the current measured reference.
#
# 2026-09-05 correction: g798544433 shards the GPU PLE table across TP ranks.
# Native TP4+EP4 loaded at 44.35 GiB/GPU without offload. Its initial 3.13 GiB KV
# budget came from a compiler/profiler transient, not a replicated resident table.
# See analysis/qwen_native_fp8_audit_20260905.md. This old cell retains its settings.
# GPU layout: TP4 on 0,1,2,3 (ACS-on PCIe ring ~19 GB/s) -> pessimistic (dagger).
# =============================================================================
CELL_NAME=qwen38flashnext_fp8_tp4
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel) + flashinfer-python 0.6.18; recipe image alternative: vllm/vllm-openai:qwen38-flash-next-x86_64-cu130"
MODEL=Qwen/Qwen3.8-Flash-Next-FP8
SERVED_MODEL_NAME=qwen38flashnext
TP=4
DP=1
REPLICAS=1
GPU_IDS=0,1,2,3                      # TP4 = all four GPUs; pessimistic (ACS-on PCIe ring)
BASE_PORT=8000
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-bfloat16}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.90}   # recipe value
ENABLE_EP=${ENABLE_EP:-0}            # recipe's 8xH200 row uses TP+EP (--moe-backend triton); A/B ENABLE_EP=1 RUN_TAG=ep
export VLLM_PLE_CPU_OFFLOAD=${VLLM_PLE_CPU_OFFLOAD:-1}   # recipe env; UNVERIFIED in vLLM main (see tp2x2 header)
HOST_RAM_NEEDED_GB=${HOST_RAM_NEEDED_GB:-204}            # Historical unverified offload-warning hint; not measured PLE residency.
CELL_EXTRA_ARGS=(
  --language-model-only
  --reasoning-parser qwen3
  --tool-call-parser qwen3_xml
  --enable-auto-tool-choice
)
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="Recipe TP4 row adapted for sm_120 (baseline env in bench/env.sh). TP4 over ACS-on PCIe: pessimistic (dagger)."
