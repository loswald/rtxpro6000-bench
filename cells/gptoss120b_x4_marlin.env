# =============================================================================
# gptoss120b_x4_marlin — openai/gpt-oss-120b (117B MoE, native MXFP4 experts;
# 65 GB on disk for the safetensors shards -- `original/` + `metal/` excluded,
# 196 GB otherwise) as FOUR independent TP1 servers, ports 8000-8003 (+ rr_proxy
# on 8080), --moe-backend marlin = the portable MXFP4 baseline on sm_120.
#
# Sources: https://recipes.vllm.ai/openai/gpt-oss-120b (tool parser `openai`;
# Blackwell rows: "FlashInfer TRTLLM MXFP4 MoE path is selected automatically"
# -- that is SM100 (B200), not sm_120; troubleshooting: "Attention sinks dtype
# error on Blackwell: pass --quantization-config.moe.activation mxfp8 and
# --kv-cache-dtype fp8").
# vLLM main 2026-09-02, vllm/model_executor/layers/fused_moe/oracle/mxfp4.py:
#   map_mxfp4_backend accepts  b12x deep_gemm flashinfer_trtllm flashinfer_cutlass
#   triton triton_unfused humming marlin aiter* xpu cpu emulation  -- anything
#   else raises "moe_backend='X' is not supported for MXFP4 MoE" (so
#   flashinfer_b12x is NOT valid for gpt-oss; b12x is -- see the _b12x cell).
#   'auto' priority: FLASHINFER_TRTLLM (SM100) -> AITER (ROCm) -> TRITON ->
#   FLASHINFER_CUTLASS -> MARLIN -> BATCHED_MARLIN, each gated by its own
#   is_supported_config(); on sm_120 expect TRITON or MARLIN (UNVERIFIED which,
#   2026-09-02) -- this cell pins marlin, the siblings pin the alternatives.
# Parsers verified in main: --tool-call-parser openai, --reasoning-parser
# openai_gptoss (chat-only effect; harmless for /v1/completions).
#
# Memory: ~63 GB weights -> ~23 GB/GPU for KV at 0.92.  gpt-oss KV is 18-37 KB/token
# at fp8 (36 layers x 8 KV heads x 64 dims; half the layers are 128-token sliding
# window, which vLLM's hybrid KV manager shrinks) -> the agent shape (34.8K
# tokens/seq) fits only ~18-35 concurrent seqs per GPU: at C>=64 on `agent` the
# server queues and TTFT balloons -- expected, logged.  TP1: no dagger.
# =============================================================================
CELL_NAME=gptoss120b_x4_marlin
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel) + flashinfer-python 0.6.18 + vllm[b12x]"
MODEL=openai/gpt-oss-120b            # prefetch with --exclude 'original/*' 'metal/*' (65 GB instead of 196)
SERVED_MODEL_NAME=gptoss120b
TP=1
DP=1
REPLICAS=${REPLICAS:-4}              # gates/run_kv_diff.sh exports REPLICAS=1 GPU_IDS=<first GPU> (KVDIFF_SINGLE_REPLICA=1)
GPU_IDS=${GPU_IDS:-0,1,2,3}          # one independent server per GPU; no cross-GPU traffic
BASE_PORT=8000
USE_PROXY=${USE_PROXY:-1}
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-fp8}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.92}
ENABLE_EP=0
CELL_EXTRA_ARGS=(
  --moe-backend "${MOE_BACKEND:-marlin}"
  --tool-call-parser openai
  --reasoning-parser openai_gptoss
  --enable-auto-tool-choice
)
# If an attention-sinks dtype error appears on this arch, the recipe's Blackwell fix is
#   --quantization-config.moe.activation mxfp8   (dotted form accepted by FlexibleArgumentParser)
# -- it targets the TRTLLM path (SM100) and is UNVERIFIED for sm_120 (2026-09-02).
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="MXFP4 marlin baseline. A/B vs gptoss120b_x4_ficutlass (expected rejected on sm_120) and gptoss120b_x4_b12x."
