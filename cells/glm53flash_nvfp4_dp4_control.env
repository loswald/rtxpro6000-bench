# Pinned GLM vendor baseline, identical model/attention precision across layouts.
CELL_NAME=glm53flash_nvfp4_dp4_control
ENGINE=vllm
SERVER_ENTRYPOINT=api_server
IMAGE_HINT="GLM vendor g487ecf187 from pinned OCI 2e771fa61545; sm120 FA2 port source hash checked"
MODEL=RedHatAI/GLM-5.3-Flash-NVFP4
MODEL_REVISION=36c184c6cda000a481711306df5adde42f63321a
SERVED_MODEL_NAME=glm53f
TP=1
DP=4
REPLICAS=1
GPU_IDS=${GPU_IDS:-0,1,2,3}
BASE_PORT=8000
KV_CACHE_DTYPE=auto
MAX_MODEL_LEN=40960
MAX_NUM_SEQS=192
MAX_NUM_BATCHED_TOKENS=16384
GPU_MEM_UTIL=0.90
ENABLE_EP=1
COMPILATION_CONFIG='{}'
export PYTHONPATH=${GLM_VENDOR_ROOT:-/workspace/glm-vendor-baseline}
export VLLM_USE_DEEP_GEMM=0 VLLM_MOE_USE_DEEP_GEMM=0
export FLASHINFER_CUDA_ARCH_LIST=12.0f TORCH_CUDA_ARCH_LIST=12.0
export HF_HUB_OFFLINE=1 VLLM_ENGINE_READY_TIMEOUT_S=1800
export MAX_JOBS=6 NVCC_THREADS=2
CELL_EXTRA_ARGS=(
  --attention-backend FLASHINFER_MLA_SPARSE_SM90
  --block-size 1024
  --reasoning-parser glm45
  --tool-call-parser glm47
  --enable-auto-tool-choice
)
if [ "${ENFORCE_EAGER:-0}" = 1 ]; then CELL_EXTRA_ARGS+=( --enforce-eager ); fi
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="DP4/TP1/EP4 GLM reference layout; sparse FA2 BF16 path. Prior 20-prompt clean result is only a smoke reference, not a headline quality gate."
