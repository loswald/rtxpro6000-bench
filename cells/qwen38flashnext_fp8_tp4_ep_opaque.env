# Same native FP8 TP4+EP4 anchor, with the audited PLE lookup compile boundary.
# Apply patches/qwen_ple_opaque_lookup.py to a stopped g798544433 deployment first.
# This cell does not patch the engine or change checkpoint/scaling/state precision.
. "$(dirname "${BASH_SOURCE[0]}")/qwen38flashnext_fp8_tp4_ep_anchor.env"
CELL_NAME=qwen38flashnext_fp8_tp4_ep_opaque
export VLLM_QWEN4EXP_PLE_OPAQUE_LOOKUP=1
# A new cache root is selected for every launch unless the operator supplies one.
# Record the explicit root in server.env; never delete a shared compiler cache.
export VLLM_CACHE_ROOT="${QWEN_OPAQUE_CACHE_ROOT:-$BENCH_ROOT/cache/qwen_ple_opaque_$(date -u +%Y%m%dT%H%M%S)_$$}"
export TORCHINDUCTOR_CACHE_DIR="$VLLM_CACHE_ROOT/torchinductor"
export TRITON_CACHE_DIR="$VLLM_CACHE_ROOT/triton"
NOTES="Native FP8 TP4+EP4 anchor with only opaque PLE lookup enabled; fresh compile cache, original FP8 table/global scale, BF16 KV/conv state and FP32 GDN state. Compare profiler peak, cache capacity, complete paired answers and warm throughput with stock."
