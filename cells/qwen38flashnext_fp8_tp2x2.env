# =============================================================================
# qwen38flashnext_fp8_tp2x2 — Qwen/Qwen3.8-Flash-Next-FP8 (176B total = 125B main
# + 51B N-gram "PLE" embedding table, 6B active; multimodal checkpoint
# Qwen4ExpForConditionalGeneration, FP8 172.78 GiB = 186 GB on disk, Hub sha
# 236dfdf 2026-08-31) as DP2 x TP2 in one vLLM server.
#
# Source: https://recipes.vllm.ai/Qwen/Qwen3.8-Flash-Next  (4x GB300 FP8 row:
# --tensor-parallel-size 4 --gpu-memory-utilization 0.90 --max-num-seqs 256
# --enable-prefix-caching --no-enable-flashinfer-autotune --enable-auto-tool-choice
# --tool-call-parser qwen3_xml --reasoning-parser qwen3; offload row:
# VLLM_PLE_CPU_OFFLOAD=1 ... "at least 51 GB [host RAM] plus runtime headroom";
# "vLLM 0.29.0+" / image vllm/vllm-openai:qwen38-flash-next(-x86_64-cu130),
# "PyPI installation is not supported"; pipeline parallel not supported).
#
# Verified against vLLM main 2026-09-02:
#   * Qwen4ExpForConditionalGeneration IS registered (vllm/models/qwen4_exp/) ->
#     the in-place-upgraded main build knows the model.
#   * --tool-call-parser qwen3_xml, --reasoning-parser qwen3, --language-model-only,
#     --kv-cache-dtype bfloat16 all exist; --no-enable-flashinfer-autotune comes
#     from bench/env.sh VLLM_COMMON_ARGS (recipe requires it).
#   * VLLM_PLE_CPU_OFFLOAD is UNVERIFIED (2026-09-02): it is NOT in main's envs.py
#     nor in vllm/models/qwen4_exp/{common/ple.py,nvidia/ple_layer.py,nvidia/model.py};
#     the PLE table is TP-REPLICATED ("The PLE cache is TP-replicated").  It is
#     exported anyway (harmless if ignored).  Consequence if ignored: each TP rank
#     holds the ~51 GB table on GPU -> TP2: 63 GB main + 51 GB PLE = 114 GB > 96 GB
#     = OOM at load for THIS cell (qwen38flashnext_fp8_tp4 still loads, KV-starved).
#     If honoured: ~51 GB host RAM per worker -> up to 4 x 51 = 204 GB for DP2xTP2
#     (1.5 TB host RAM: fits; launch.sh warns, not dies, on low free RAM).
#     Look for "PLE"/"offload" lines in server_p8000.log at the first launch.
#     Fallback if the env var is ignored: vLLM's generic --cpu-offload-gb N (weights
#     paged from host RAM) -- UNVERIFIED for this model.
#
# GPU layout (decision 3): GPU_IDS=0,2,1,3 -> DP rank0 = physical 0,2, rank1 = 1,3
# (i-th TP-sized slice of CUDA_VISIBLE_DEVICES per DP rank): cross-switch pairs,
# ~38 vs ~21 GB/s all_reduce on this ACS-on host.  TP2 over PCIe -> dagger.
#
# Memory (offload working): ~125 GB main / TP2 = ~63 GB/GPU -> ~23 GB/GPU for KV
# at 0.90 (bf16 KV per CONTEXT).  If host RAM or KV is too small, use the tp4 cell.
# =============================================================================
CELL_NAME=qwen38flashnext_fp8_tp2x2
ENGINE=${ENGINE:-vllm}
IMAGE_HINT="vLLM main 2026-09-02 (0.28.1rc1.dev312+g41848caa6, cu130 nightly wheel) + flashinfer-python 0.6.18; recipe image alternative: vllm/vllm-openai:qwen38-flash-next-x86_64-cu130 (2026-08-26)"
MODEL=Qwen/Qwen3.8-Flash-Next-FP8
SERVED_MODEL_NAME=qwen38flashnext
TP=2
DP=2
REPLICAS=1
GPU_IDS=0,2,1,3                      # DP rank0 -> phys 0,2 ; rank1 -> phys 1,3 (cross-switch pairs, see header)
BASE_PORT=8000
KV_CACHE_DTYPE=${KV_CACHE_DTYPE:-bfloat16}
MAX_MODEL_LEN=${MAX_MODEL_LEN:-40960}
MAX_NUM_SEQS=${MAX_NUM_SEQS:-256}
MAX_NUM_BATCHED_TOKENS=${MAX_NUM_BATCHED_TOKENS:-8192}
GPU_MEM_UTIL=${GPU_MEM_UTIL:-0.90}   # recipe value
ENABLE_EP=${ENABLE_EP:-0}            # two independent TP2 replicas; ENABLE_EP=1 RUN_TAG=ep to A/B (all-to-all over PCIe)
export VLLM_PLE_CPU_OFFLOAD=${VLLM_PLE_CPU_OFFLOAD:-1}   # recipe env; UNVERIFIED in vLLM main (see header)
# launch.sh estimates PLE_TABLE_GB x TP x DP x replicas (= 51 x 2 x 2 = 204 GB here: the table is
# TP-replicated, one ~51 GB copy per WORKER) and takes max(estimate, this hint) -> warn, never die.
HOST_RAM_NEEDED_GB=${HOST_RAM_NEEDED_GB:-204}
CELL_EXTRA_ARGS=(
  --language-model-only              # text-only bench: skip the vision tower (multimodal checkpoint)
  --reasoning-parser qwen3
  --tool-call-parser qwen3_xml
  --enable-auto-tool-choice
)
# MTP spec-decode exists for this model ('{"method":"mtp","num_speculative_tokens":3}') but is OFF: throughput campaign.
BENCH_BACKEND=openai
BENCH_ENDPOINT=/v1/completions
BENCH_EXTRA_ARGS=( )
LOADTEST_ONLY=0
NOTES="Host-RAM sensitive (TP-replicated PLE table x 4 workers if offloaded) and fits on GPU only if VLLM_PLE_CPU_OFFLOAD is honoured. Recipe forbids pipeline parallel. TP2: pessimistic (dagger)."
